{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/payloads/document-paper-pack-v1.schema.json",
  "title": "Document Paper Pack Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "artifact_refs",
    "metadata"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object"
    }
  }
}
