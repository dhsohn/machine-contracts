{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/payloads/document-run-result-v1.schema.json",
  "title": "Document Run Result Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "target",
    "ok",
    "cells",
    "tables",
    "artifact_refs"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["block", "page"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "ok": {
      "type": "boolean"
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stdout", "figure_artifact_refs", "error"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "stdout": {"type": "string"},
          "figure_artifact_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "error": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "artifact_ref"],
        "properties": {
          "name": {"type": "string"},
          "artifact_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
